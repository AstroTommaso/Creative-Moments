# Copy to .env (git-ignored) for local development.

# Prisma connection to the Supabase Postgres database.
# DATABASE_URL: pooled connection (pgbouncer, port 6543) for normal runtime queries.
# DIRECT_URL: direct connection (port 5432), used only by `prisma migrate`.
DATABASE_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase project, used ONLY server-side to read/write Storage with the
# service_role key. Never expose this key to any client.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-from-project-settings-api>"

# Public base URL of this backend once deployed (used to build the
# password-reset email link: <APP_BASE_URL>/reset-password?token=...).
APP_BASE_URL="http://localhost:3000"

# SMTP (leave empty in development: emails are logged to the console instead).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@creativemoments.app"
