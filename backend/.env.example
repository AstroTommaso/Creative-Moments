# Copy to .env (git-ignored) for local development.

# Prisma connection to the Supabase Postgres database, via Supavisor (the
# pooler) rather than the "Direct connection" host — direct connections use
# IPv6 by default, which most hosts (Railway included) can't reach. Get both
# strings from Supabase's "Connect to your project" dialog: DATABASE_URL is
# the "Transaction pooler" one (port 6543, append ?pgbouncer=true), DIRECT_URL
# is the "Session pooler" one (port 5432) — used only by `prisma migrate`.
# Note the username is `postgres.<project-ref>` (with a dot), not `postgres`.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase project, used ONLY server-side to read/write Storage with the
# service_role key. Never expose this key to any client.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-from-project-settings-api>"

# Public base URL of this backend once deployed (used to build the
# password-reset email link: <APP_BASE_URL>/reset-password?token=...).
APP_BASE_URL="http://localhost:3000"

# SMTP (leave empty in development: emails are logged to the console instead).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@creativemoments.app"
